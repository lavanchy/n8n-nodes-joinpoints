{
    "name": "n8n-nodes-joinpoint",
    "version": "0.1.0",
    "description": "n8n community node to interact with the Joinpoint API.",
    "license": "MIT",
    "keywords": [
        "n8n-community-node-package",
        "joinpoint",
        "api"
    ],
    "author": {
        "name": "Loic Lavanchy, Lavanchy Automation",
        "email": "lo.lavanchy@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lavanchy/n8n-joinpoin-nodes.git"
    },
    "homepage": "https://github.com/lavanchy/n8n-joinpoin-nodes#readme",
    "bugs": {
        "url": "https://github.com/lavanchy/n8n-joinpoin-nodes/issues"
    },
    "engines": {
        "node": ">=20.15"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "nodes": [
            "dist/nodes/Joinpoint/Joinpoint.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "^0.41.2",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
